# =============================================================================
# Garmin credentials — required for initial auth and re-auth on token expiry
# =============================================================================
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=yourpassword

# =============================================================================
# Garmin token storage
#
# Option A (recommended for Railway): paste the content of ~/.garminconnect_base64
# after running `garmin-mcp-auth` locally. This avoids needing the filesystem.
# =============================================================================
# GARMINTOKENS_BASE64_CONTENT=<paste content of ~/.garminconnect_base64 here>

# Option B: file-based token path (default for local/Docker use)
# GARMINTOKENS=~/.garminconnect

# =============================================================================
# MCP HTTP transport (set to "sse" for Railway/hosted, "stdio" for local)
# =============================================================================
MCP_TRANSPORT=sse

# =============================================================================
# Multi-user mode (recommended) — one Garmin account per person
# Each person gets their own API key and their own Garmin credentials.
# tokens_b64 is optional — get it by running garmin-mcp-auth locally and
# copying the contents of ~/.garminconnect_base64
# =============================================================================
MCP_USERS=[{"key":"change-me-key1","name":"Jason","email":"jason@gmail.com","password":"pass1","tokens_b64":""},{"key":"change-me-key2","name":"Friend","email":"friend@gmail.com","password":"pass2","tokens_b64":""}]

# =============================================================================
# Single-user mode (simpler, one Garmin account for everyone)
# Use this instead of MCP_USERS if only one Garmin account is needed.
# =============================================================================
# MCP_API_KEYS=change-me-key1,change-me-key2

# =============================================================================
# Server port — Railway sets this automatically, override for local testing
# =============================================================================
PORT=8000
