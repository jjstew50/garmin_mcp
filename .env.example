# =============================================================================
# Garmin credentials — required for initial auth and re-auth on token expiry
# =============================================================================
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=yourpassword

# =============================================================================
# Garmin token storage
#
# Preferred (multi-user): set oauth1_token / oauth2_token inside MCP_USERS above.
# Tokens are seeded to the volume on first boot and reused on subsequent starts.
#
# Global fallbacks (single-user or legacy):
#   GARMIN_OAUTH1_TOKEN — base64 of oauth1_token.json, seeded on first boot
#   GARMIN_OAUTH2_TOKEN — base64 of oauth2_token.json, seeded on first boot
#   GARMINTOKENS_BASE64_CONTENT — full garth dump for single-user hosted mode
#
# File-based token path (default for local/Docker use):
# GARMINTOKENS=~/.garminconnect
# =============================================================================
# GARMIN_OAUTH1_TOKEN=<base64>
# GARMIN_OAUTH2_TOKEN=<base64>
# GARMINTOKENS_BASE64_CONTENT=<paste content of ~/.garminconnect_base64 here>

# =============================================================================
# MCP HTTP transport (set to "sse" for Railway/hosted, "stdio" for local)
# =============================================================================
MCP_TRANSPORT=sse

# =============================================================================
# Multi-user mode (recommended) — one Garmin account per person
# Each person gets their own API key, credentials, tokens, and feature flags.
#
# Per-user fields:
#   oauth1_token    base64 of oauth1_token.json  (run garmin-mcp-auth locally)
#   oauth2_token    base64 of oauth2_token.json  (run garmin-mcp-auth locally)
#   training_memory true/false — enable training plans/phases/notes for this user
#   tokens_b64      legacy: full garth dump (use oauth1_token/oauth2_token instead)
#
# oauth1_token/oauth2_token are seeded to the volume on first boot only.
# If token files already exist on the volume, email/password fallback is skipped
# (prevents Garmin's 429 rate limit on restarts).
# =============================================================================
MCP_USERS=[{"key":"change-me-key1","name":"TEST","email":"test@gmail.com","password":"pass1","oauth1_token":"","oauth2_token":"","training_memory":true},{"key":"change-me-key2","name":"Friend","email":"friend@gmail.com","password":"pass2","oauth1_token":"","oauth2_token":"","training_memory":false}]

# =============================================================================
# Single-user mode (simpler, one Garmin account for everyone)
# Use this instead of MCP_USERS if only one Garmin account is needed.
# =============================================================================
# MCP_API_KEYS=change-me-key1,change-me-key2

# =============================================================================
# Server port — Railway sets this automatically, override for local testing
# =============================================================================
PORT=8000
